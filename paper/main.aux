\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Hierarchical scene graph representation and bottom-up construction pipeline. (a)\nonbreakingspace Keyframes are sampled from the long video. (b)\nonbreakingspace A VLM generates frame-level scene graphs; entity alignment maintains identity consistency via a shared video-level entity registry. (c)\nonbreakingspace The three-level representation: frame-level graphs capture per-keyframe entity-relation snapshots, segment-level graphs aggregate temporal interactions within sliding windows, and the global event graph organizes high-level event semantics with explicit event edges.}}{3}{figure.caption.5}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:graph}{{1}{3}{Hierarchical scene graph representation and bottom-up construction pipeline. (a)~Keyframes are sampled from the long video. (b)~A VLM generates frame-level scene graphs; entity alignment maintains identity consistency via a shared video-level entity registry. (c)~The three-level representation: frame-level graphs capture per-keyframe entity-relation snapshots, segment-level graphs aggregate temporal interactions within sliding windows, and the global event graph organizes high-level event semantics with explicit event edges}{figure.caption.5}{}}
